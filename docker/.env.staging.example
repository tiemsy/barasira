APP_KEY=base64:replace-with-a-generated-laravel-key
APP_URL=https://staging.example.com
APP_PORT=8080

DB_DATABASE=BaraSira
DB_USERNAME=BaraSira
DB_PASSWORD=replace-with-a-strong-password
DB_ROOT_PASSWORD=replace-with-another-strong-password

SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters

# Brevo SMTP transactionnel
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=replace-with-your-brevo-smtp-login
MAIL_PASSWORD=replace-with-your-brevo-smtp-key
MAIL_FROM_ADDRESS=staging@BaraSira.com
MAIL_FROM_NAME="BaraSira Staging"
MAIL_CONTACT_ADDRESS=contact@BaraSira.com
